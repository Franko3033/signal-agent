# Bu faylni nusxalab "config.env" deb nomlang va qiymatlarni kiriting.
# config.env ni hech kimga yubormang! (GitHub'da bu qiymatlar Secrets'ga qo'yiladi)

# altFINS: Profil → API Key bo'limidan
ALTFINS_API_KEY=

# Telegram: @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# "python agent.py --get-chat-id" buyrug'i ko'rsatadi
TELEGRAM_CHAT_ID=

# --- Sozlamalar (o'zgartirmasangiz ham bo'ladi) ---
# Sessiya ochilishidan necha daqiqa oldin kuzatuv boshlansin
MINUTES_BEFORE_SESSION=30
# 5M tasdiqni necha daqiqa kutish
WATCH_MINUTES=120
# Kuzatuv davomida altFINS'dan yangi signallarni necha daqiqada bir olish
REFRESH_MINUTES=30
# Boshida so'nggi necha daqiqadagi altFINS signallari olinsin
LOOKBACK_MINUTES=120
# Minimal baho (5 tadan): 1H trend, 15M trend, RSI, MACD, hajm
MIN_SCORE=3
# RSI shundan yuqori bo'lsa signal tashlanadi
MAX_RSI=80
# Bir sessiyada nechta signal (1 = faqat eng yaxshisi)
MAX_SIGNALS=1
# Kuzatuvga olingan coinlar ro'yxatini ham yuborish
SEND_WATCHLIST=false
# Sessiyada signal bo'lmasa xabar berish
SEND_EMPTY_REPORT=true
# TP1 uchun risk/reward
MIN_RR=2
# Bir coin qayta yuborilmaydigan muddat (soat)
DEDUP_HOURS=12
# Shanba-yakshanba o'tkazib yuborish
SKIP_WEEKENDS=true
# Faqat 15M signallar
ONLY_15M=true
